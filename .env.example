# 原有 CLI / GitHub Actions 环境变量参考。
# GitHub Pages 模式在页面初始化和配置，Actions 从仓库 Secrets 读取。
READ_NUM=40
WXREAD_CURL_BASH=
WXREAD_ACCOUNTS_JSON=

# 可选：旧式邮件配置，首次初始化加密状态时导入。
PUSH_METHOD=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_TO=

# 兼容原有通知方式
PUSHPLUS_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WXPUSHER_SPT=
SERVERCHAN_SPT=

# Pages 自动创建此仓库 Secret，不要把私钥填入或提交代码。
# WXREAD_CONTROL_KEY=
