# 原有 CLI / GitHub Actions 环境变量参考。
# GitHub Pages 模式在页面初始化和配置，Actions 从仓库 Secrets 读取。
READ_NUM=40
WXREAD_CURL_BASH=
WXREAD_ACCOUNTS_JSON=

# 可选：旧式邮件配置，首次初始化加密状态时导入。
PUSH_METHOD=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_TO=

# 支持单个渠道或英文逗号分隔多个渠道，例如 email,pushplus,webhook。
# Pages 页面可独立启用每个渠道；已有 Secrets 会首次导入加密通知配置。
PUSHPLUS_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WXPUSHER_SPT=
SERVERCHAN_SPT=

# Webhook 类型：wecom（企业微信）、feishu（飞书）、dingtalk（钉钉）、json（通用）。
WEBHOOK_TYPE=wecom
WEBHOOK_URL=
# 飞书、钉钉开启加签时填写；企业微信无需填写。
WEBHOOK_SECRET=
# 可选 JSON 对象，例如 {"Authorization":"Bearer ..."}。
WEBHOOK_HEADERS=

# Pages 自动创建此仓库 Secret，不要把私钥填入或提交代码。
# WXREAD_CONTROL_KEY=
